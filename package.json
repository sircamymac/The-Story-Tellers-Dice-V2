{
  "name": "storytellers-dice",
  "version": "1.0.0",
  "description": "The Storyteller's Dice: story seeds, a tale book and battle maps",
  "main": "electron/main.js",
  "author": "Storytellers Dice",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.storytellers.dice",
    "productName": "Storytellers Dice",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "www/**/*", "package.json"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "StorytellersDice-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "StorytellersDice-Portable-${version}.${ext}" }
  }
}
